<?xml version="1.0" encoding="UTF-8"?>
<!--
  Icecast config for Homebrew on macOS (Apple Silicon: /opt/homebrew/opt/icecast).
  Intel Homebrew: replace prefix with /usr/local/opt/icecast

  mkdir -p /tmp/icecast-log
  icecast -c /path/to/lurkbot-backend/infra/icecast/icecast.homebrew.xml

  If you see "Could not create listener socket": an old Icecast is still running.
  Fix: pkill icecast  then start again (only one instance; check: pgrep -l icecast)

  Passwords must match Laravel .env (ICECAST_SOURCE_PASSWORD, etc.).
-->
<icecast>
    <location>local</location>
    <admin>admin@localhost</admin>

    <limits>
        <clients>256</clients>
        <sources>32</sources>
        <queue-size>524288</queue-size>
        <!-- Longer timeouts: YouTube/DASH can stall >10s between fragments; low source-timeout drops FFmpeg mid-song. -->
        <client-timeout>120</client-timeout>
        <header-timeout>30</header-timeout>
        <source-timeout>180</source-timeout>
        <burst-on-connect>0</burst-on-connect>
        <burst-size>65535</burst-size>
    </limits>

    <authentication>
        <source-password>lurkbot_dev</source-password>
        <relay-password>lurkbot_dev_relay</relay-password>
        <admin-user>admin</admin-user>
        <admin-password>lurkbot_dev_admin</admin-password>
    </authentication>

    <hostname>127.0.0.1</hostname>

    <!-- 8001: Laravel `php artisan serve` uses 8000 on the same machine. Match ICECAST_PORT in .env. -->
    <listen-socket>
        <port>8001</port>
    </listen-socket>

    <http-headers>
        <header name="Access-Control-Allow-Origin" value="*"/>
    </http-headers>

    <paths>
        <basedir>/opt/homebrew/opt/icecast/share/icecast</basedir>
        <logdir>/tmp</logdir>
        <webroot>/opt/homebrew/opt/icecast/share/icecast/web</webroot>
        <adminroot>/opt/homebrew/opt/icecast/share/icecast/admin</adminroot>
        <alias source="/" destination="/status.xsl"/>
    </paths>

    <logging>
        <accesslog>access.log</accesslog>
        <errorlog>error.log</errorlog>
        <loglevel>3</loglevel>
        <logsize>10000</logsize>
    </logging>

    <security>
        <chroot>0</chroot>
    </security>

    <!-- Silence fallback: run `infra/icecast/start-silence-local.sh` (ffmpeg) so this mount exists. -->
    <mount type="default">
        <public>1</public>
        <stream-name>IMVU room stream</stream-name>
        <stream-description>lurkbot</stream-description>
        <content-type>audio/mpeg</content-type>
        <fallback-mount>/lurkbot-silence.mp3</fallback-mount>
        <fallback-override>1</fallback-override>
    </mount>
</icecast>
