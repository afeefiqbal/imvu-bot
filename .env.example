APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Marketing / contact page (optional overrides; defaults match public demo copy)
# CONTACT_ADDRESS="Mirpur 12 , Dhaka .Bangladesh"
# CONTACT_PHONE="+(008) 012589631"
# CONTACT_EMAIL=example@gmail.com
# CONTACT_HELP_PHONE="(406) 555-0120"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Groq (bot mention / !alexa) — see LurkController
# GROQ_API_KEY=

# Character.AI "Siva" (!s, !siva, siva) — POST /api/siva-chat
# CHARACTER_AI_API_URL=
# CHARACTER_AI_API_KEY=
# CHARACTER_AI_CHARACTER_ID=
# Use "Token" if your bridge expects Authorization: Token … instead of Bearer
# CHARACTER_AI_AUTH_HEADER=Bearer

# multi-launcher child script (default imvu-bot.js = parallel bots, rooms from API; no login). Seed sessions: BOT_NAME=<n> node room-joiner.js once per bot → profiles/<n>/.
# IMVU_LAUNCH_SCRIPT=imvu-bot.js
# Use room-joiner from the launcher only if you want login+join inside each child: IMVU_LAUNCH_SCRIPT=room-joiner.js
#
# imvu-bot: max concurrent IMVU room tabs per Chrome (default 20).
# IMVU_MAX_TABS=20
#
# IMVU multi-launcher — outbound IPs when imvu_bots.proxy is empty (round-robin).
# Set to 1 to stop using Webshare / PROXY_DISCOVERY_URL (test IMVU on direct IP; confirms tunnel failures are proxy-side).
# IMVU_DISABLE_AUTO_PROXY=1
#
# With several bots and an empty pool, every bot shares your server IP (throttle risk) — set PROXY_POOL or per-row proxy:
# PROXY_POOL=http://user:pass@1.2.3.4:8080,http://user:pass@5.6.7.8:8080
#
# multi-launcher splits URLs into BOT_PROXY_HOST / BOT_PROXY_USER / BOT_PROXY_PASS for each child (BOT_PROXY left empty).
# Manual runs: either one line BOT_PROXY=http://user:pass@host:port or split:
# BOT_PROXY_HOST=host:port
# BOT_PROXY_USER=
# BOT_PROXY_PASS=
# Or auto-fetch from a Webshare account (free tier): https://www.webshare.io → API token
# WEBSHARE_API_TOKEN=
# Webshare API mode: direct = ip:port per row; backbone = p.webshare.io (typical for residential).
# If Chrome shows ERR_TUNNEL_CONNECTION_FAILED on every IP, use backbone.
# WEBSHARE_PROXY_MODE=backbone
# On login/chrome-error with a pool-assigned proxy, multi-launcher refetches this many endpoints for a new IP
# WEBSHARE_ROTATE_FETCH_COUNT=25
# Cap automatic Webshare/pool proxy swaps per stuck bot (then retry same proxy)
# IMVU_MAX_PROXY_ROTATIONS=10
# Or any GET URL that returns JSON [{...}] / ["url"] / newline ip:port (optional)
# PROXY_DISCOVERY_URL=

# user-tracker: skip chat welcome if same username was welcomed within this window (ms). 0 = off. Cuts spam on leave/rejoin.
# IMVU_WELCOME_REJOIN_MS=600000
# room-joiner: force re-auth after N ms (0 = never). Example 24h: 86400000
# IMVU_SESSION_MAX_MS=0
# room-joiner: max wait for Join CTA (default 120000). Raise when running 2+ Chromes.
# IMVU_JOIN_CTA_WAIT_MS=120000
# After opening a room URL, wait this long for SPA / join-cta (datacenter proxies often need 45–90s).
# IMVU_ROOM_HYDRATE_MS=55000
# After login submit: wait for redirect off secure/welcome (ms). Raise on slow proxies.
# IMVU_POST_LOGIN_REDIRECT_MS=90000
# Log progress every N ms while waiting (0 = off).
# IMVU_POST_LOGIN_PROGRESS_MS=15000
# Extra settle time before loading Next (ms).
# IMVU_POST_LOGIN_SETTLE_MS=12000
# Polling windows for strict / relaxed session checks post-login (ms).
# IMVU_SESSION_STRICT_WAIT_MS=70000
# IMVU_SESSION_RELAXED_WAIT_MS=45000
#
# discord-server (node lurkbot-bot/discord-server.js): bot token + default guild/parent channel for per-room channels.
# DISCORD_TOKEN=
# DISCORD_CHANNEL_ID=
#
# imvu-bot / room-joiner → POST chat + init-room to this URL (discord-server listens on 3000):
# DISCORD_BOT_API_URL=http://127.0.0.1:3000/api/imvu-chat
#
# Optional: duplicate DOM-based welcome + AI in imvu-bot (default off; CDP user-tracker handles it).
# IMVU_DOM_CHAT_AI=1
#
# multi-launcher sets IMVU_DISCORD_RELAY_PORTS + per-child IMVU_DISCORD_RELAY_PORT automatically.
# Solo `node room-joiner.js`: set both so discord-server can reach this process, e.g.
# IMVU_DISCORD_RELAY_PORT=30900
# IMVU_DISCORD_RELAY_PORTS=30900
# Optional first port when multi-launcher assigns 30900, 30901, …
# IMVU_DISCORD_RELAY_BASE=30900
