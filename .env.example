# Copy to .env and adjust.

# Local Valet HTTPS: multi-launcher auto-loads ~/.config/valet/CA/…pem via NODE_EXTRA_CA_CERTS.
# Set IMVU_SKIP_VALET_CA=1 to disable that re-exec.
# BOT_API_BASE_URL=https://aetherroom.test

BOT_API_BASE_URL=http://imvu-bot-laravel.test
APP_ENV=local
BOT_NAME=YourBot
IMVU_MAX_ROOMS=20

# Discord (optional)
DISCORD_BOT_API_URL=http://127.0.0.1:3000/api/imvu-chat
BOT_API_BASE_URL=http://imvu-bot-laravel.test
# Guild ID or any channel/category in that server (bot must be invited to the server)
DISCORD_GUILD_ID=
# Shared community guild for website users without their own Discord (same as Laravel DISCORD_SHARED_GUILD_ID)
DISCORD_SHARED_GUILD_ID=
DISCORD_CHANNEL_ID=
IMVU_DISCORD_RELAY_BASE=30900

IMVU_LURK_ENABLED=1
IMVU_MOVE_COMMAND_DELAY_MS=5000
IMVU_SCALE_CHECK_INTERVAL_MS=30000
IMVU_KICK_ENABLED=1
IMVU_AUTOBOOT_ENABLED=0
IMVU_SYNC_INTERVAL_MS=25000
IMVU_SYNC_JITTER_MS=10000
# Optional override; defaults to Faizii Discord profile if empty
BOT_DISCORD_INVITE_URL=https://discord.com/users/651063231745359882

IMVU_SOCIAL_SYNC_ENABLED=0
IMVU_SOCIAL_SYNC_INTERVAL_MS=4000
IMVU_INVITE_CHAT_LOOKUP_MS=8000
IMVU_DM_JOIN_ENABLED=0

# Chat intro after the bot becomes visible ({bot}, {room}). Empty = random funny built-ins.
IMVU_WS_INTRO_ENABLED=0
# IMVU_WS_INTRO_MESSAGE=A wild {bot} appeared in {room}! It used !help. It's super effective.
# IMVU_WS_INTRO_MESSAGE_DELAY_MS=1500

# Stay visible in rooms: heartbeat POSTs /chat/.../participants (~3 min). Self-rejoin recovers if IMVU still drops you.
# IMVU_VISIBLE_HEARTBEAT_MS=180000
# IMVU_FORCE_VISIBLE_REFRESH_MS=120000
# IMVU_SELF_REJOIN=1
# IMVU_SELF_REJOIN_ON_PARTICIPANT_DELETE=1
# Suppress self-rejoin while radio stop/set runs (participant-delete flaps).
# IMVU_RADIO_SELF_REJOIN_QUIET_MS=60000
# Re-push last Icecast URL after self-rejoin (max age).
# IMVU_RADIO_REAPPLY_MAX_AGE_MS=7200000
# IMVU_LEAVE_ROOMS_ON_SHUTDOWN=0


IMVU_PROFILE_SYNC_ENABLED=1
IMVU_PROFILE_SYNC_COOLDOWN_MS=21600000

IMVU_VERIFY_DM_RETRY_MS=120000
IMVU_VERIFY_DM_RATE_LIMIT_MS=600000
IMVU_VERIFY_DM_FRIEND_PENDING_MS=900000

# Room music (!play / !p / !queue / !skip / !stop)
# Prefer VibeVerse (Option A): search + stream URL → update IMVU room media URL each play
IMVU_MUSIC_ENABLED=0
MUSIC_ENABLED=0
VIBEVERSE_API_URL=https://vibeverse-api.vvpz.workers.dev

# Legacy Icecast path (only used when VIBEVERSE_API_URL is empty)
ICECAST_HOST=127.0.0.1
ICECAST_PORT=8001
ICECAST_SOURCE_USER=source
ICECAST_SOURCE_PASSWORD=
ICECAST_MOUNT_TEMPLATE=/imvu-{room}.mp3
MUSIC_PUBLIC_STREAM_URL_TEMPLATE=
CLOUDFLARE_TUNNEL_AUTO=0
NGROK_TUNNEL_AUTO=0
YTDLP_PATH=yt-dlp
# YTDLP_COOKIES_FILE=/path/to/youtube-cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YouTube downloads via Webshare (avoids OCI datacenter bot-blocks). Needs WEBSHARE_API_TOKEN.
# YTDLP_WEBSHARE=1
# YTDLP_WEBSHARE_MODE=backbone
# Or set an explicit proxy URL instead of auto-fetch:
# YTDLP_PROXY=http://user:pass@p.webshare.io:80
# PO Token provider (bgutil HTTP on :4416) — helps “not a bot” with cookies.
# YTDLP_PO_TOKEN=1
# YTDLP_BGUTIL_BASE_URL=http://127.0.0.1:4416
# YTDLP_YOUTUBE_PLAYER_CLIENT=default,mweb
# Idle autoplay when the queue empties (VibeVerse + Icecast modes).
# After !play/!add, random READY/trending tracks keep playing until !stop.
# MUSIC_AUTOPLAY=1
# MUSIC_AUTOPLAY_PLAYLIST_URL=
# MUSIC_AUTOPLAY_PLAYLIST_MAX_ITEMS=100
# MUSIC_AUTOPLAY_AFTER_STOP=0
# MUSIC_AUTOPLAY_AFTER_STOP_MS=2500
# MUSIC_AUTOPLAY_ON_JOIN=0
# MUSIC_AUTOPLAY_ROOMS=

