# Copy to .env and adjust.

BOT_API_BASE_URL=http://imvu-bot-laravel.test
APP_ENV=local
BOT_NAME=YourBot
IMVU_MAX_ROOMS=20

# Discord (optional)
DISCORD_BOT_API_URL=http://127.0.0.1:3000/api/imvu-chat
DISCORD_CHANNEL_ID=
IMVU_DISCORD_RELAY_BASE=30900

# Room commands: !move !roomcheck !newgreeting !autogreet !scale !maxscaler !minage !nolurk !maxoccupancy
IMVU_ROOM_COMMANDS_ENABLED=1
IMVU_LURK_ENABLED=1
IMVU_MOVE_COMMAND_DELAY_MS=5000
IMVU_SCALE_CHECK_INTERVAL_MS=30000

# Kick / autoboot (see README)
IMVU_KICK_ENABLED=1
IMVU_AUTOBOOT_ENABLED=0
