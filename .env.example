# Copy to .env and adjust.

BOT_API_BASE_URL=http://imvu-bot-laravel.test
APP_ENV=local
BOT_NAME=YourBot
IMVU_MAX_ROOMS=20

# Discord (optional)
DISCORD_BOT_API_URL=http://127.0.0.1:3000/api/imvu-chat
BOT_API_BASE_URL=http://imvu-bot-laravel.test
# Guild ID or any channel/category in that server (bot must be invited to the server)
DISCORD_GUILD_ID=
# Shared community guild for website users without their own Discord (same as Laravel DISCORD_SHARED_GUILD_ID)
DISCORD_SHARED_GUILD_ID=
DISCORD_CHANNEL_ID=
IMVU_DISCORD_RELAY_BASE=30900

# Room commands: !move !roomcheck !newgreeting !autogreet !scale !maxscaler !minage !nolurk !maxoccupancy
IMVU_ROOM_COMMANDS_ENABLED=1
IMVU_LURK_ENABLED=1
IMVU_MOVE_COMMAND_DELAY_MS=5000
IMVU_SCALE_CHECK_INTERVAL_MS=30000

# Kick / autoboot (see README)
IMVU_KICK_ENABLED=1
IMVU_AUTOBOOT_ENABLED=0

# Laravel sync loop (POST /api/rooms/sync) — pending_messages, pending_kicks, pending_leave_rooms, pending_music, pending_profile_fetches
IMVU_SYNC_INTERVAL_MS=25000
IMVU_SYNC_JITTER_MS=10000

# Optional Discord invite shown by !discord in rooms
BOT_DISCORD_INVITE_URL=

# IMVU social sync (friend accept, room invites, DM !join). Off by default — enable only if you use those flows.
IMVU_SOCIAL_SYNC_ENABLED=0
IMVU_SOCIAL_SYNC_INTERVAL_MS=4000
IMVU_INVITE_CHAT_LOOKUP_MS=8000
IMVU_DM_JOIN_ENABLED=0

# Ctrl+C / shutdown: default keeps the bot avatar IN the room (websocket closes only).
# Set to 1 only if you want DELETE /participants on exit (bot visibly leaves).
# IMVU_LEAVE_ROOMS_ON_SHUTDOWN=0

# IMVU profile sync to Laravel (POST /api/imvu-profile on room join)
IMVU_PROFILE_SYNC_ENABLED=1
IMVU_PROFILE_SYNC_COOLDOWN_MS=21600000

# Verification DM delivery backoff (IMVU RATE-001 / 429)
IMVU_VERIFY_DM_RETRY_MS=120000
IMVU_VERIFY_DM_RATE_LIMIT_MS=600000
IMVU_VERIFY_DM_FRIEND_PENDING_MS=900000
