APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Local: must match `php artisan serve` (default port 8000). Bot reads APP_URL via ./scripts/run-all.sh export + .env.
APP_URL=http://127.0.0.1:8000

# --- Production (set in Railway / host dashboard — do not commit real secrets) ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-service.up.railway.app
# APP_KEY=base64:…   # php artisan key:generate --show
# LOG_LEVEL=error
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
# scripts/railway-web-and-bot.sh runs `php artisan migrate --force` on boot unless:
# SKIP_DATABASE_MIGRATE=1
# Bot→Laravel HTTP from the same container: railway-web-and-bot.sh sets BOT_API_BASE_URL=http://127.0.0.1:$PORT
# (override only if you split web and bot across services).
# If you use QUEUE_CONNECTION=database, run a worker: php artisan queue:work (separate process/service).
# IMVU / Puppeteer: mount a Railway Volume at exactly /app/lurkbot-bot/profiles so
# lurkbot-bot/profiles/<BOT_NAME>/ survives redeploys (Chrome cookies). Dashboard → your
# service → Volumes → mount path /app/lurkbot-bot/profiles. Then run room-joiner once per bot to seed login.
# Icecast on Railway: ICECAST_HOST + ICECAST_HOST_SUFFIX=.railway.internal + ICECAST_PORT (see music comments below).
# Cloudflare trycloudflare quick tunnels often fail from cloud egress (HTTP 500 / error 1101). Mitigations: CLOUDFLARE_QUICK_TUNNEL_RETRIES + CLOUDFLARE_QUICK_TUNNEL_RETRY_MS, MUSIC_TUNNEL_FALLBACK_NGROK=1 (+ ngrok in image + NGROK_AUTHTOKEN), or set MUSIC_PUBLIC_STREAM_URL_TEMPLATE to a stable HTTPS URL / named Cloudflare tunnel.

# Copied Railway .env? With APP_ENV=local, multi-launcher clears ICECAST_HOST_SUFFIX always; it clears CLOUDFLARE_/NGROK_ tunnel AUTO vars only when MUSIC_ENABLED and IMVU_MUSIC_ENABLED are off (opt out: LURKBOT_KEEP_RAILWAY_ENV=1).

# Marketing / contact page (optional overrides; defaults match public demo copy)
# CONTACT_ADDRESS="Mirpur 12 , Dhaka .Bangladesh"
# CONTACT_PHONE="+(008) 012589631"
# CONTACT_EMAIL=example@gmail.com
# CONTACT_HELP_PHONE="(406) 555-0120"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Groq (bot mention / !alexa) — see LurkController
# GROQ_API_KEY=

# Character.AI "Siva" (!s, !siva, siva) — POST /api/siva-chat
# CHARACTER_AI_API_URL=
# CHARACTER_AI_API_KEY=
# CHARACTER_AI_CHARACTER_ID=
# Use "Token" if your bridge expects Authorization: Token … instead of Bearer
# CHARACTER_AI_AUTH_HEADER=Bearer

# multi-launcher child script (default imvu-bot.js = parallel bots, rooms from API). imvu-bot does not log in — multi-launcher runs the same IMVU login path in-process (runProfileLoginBootstrap from room-joiner) before each imvu-bot by default (cookies → profiles/<BOT_NAME>/; mount a volume on lurkbot-bot/profiles in prod).
# IMVU_LAUNCH_SCRIPT=imvu-bot.js
# Use room-joiner from the launcher only if you want login+join inside each child: IMVU_LAUNCH_SCRIPT=room-joiner.js
# Skip the default login bootstrap (faster restarts if the profile session is already valid):
# IMVU_SKIP_BOOTSTRAP_PROFILE=1
# Legacy: IMVU_BOOTSTRAP_PROFILE_BEFORE_IMVU_BOT=0 also skips the same step (previously =1 was required to enable).
#
# imvu-bot: max concurrent IMVU room tabs per Chrome (default 20).
# IMVU_MAX_TABS=20
#
# IMVU multi-launcher — outbound IPs when imvu_bots.proxy is empty (round-robin).
# Set to 1 to stop using Webshare / PROXY_DISCOVERY_URL (test IMVU on direct IP; confirms tunnel failures are proxy-side).
# IMVU_DISABLE_AUTO_PROXY=1
#
# With several bots and an empty pool, every bot shares your server IP (throttle risk) — set PROXY_POOL or per-row proxy:
# PROXY_POOL=http://user:pass@1.2.3.4:8080,http://user:pass@5.6.7.8:8080
#
# multi-launcher splits URLs into BOT_PROXY_HOST / BOT_PROXY_USER / BOT_PROXY_PASS for each child (BOT_PROXY left empty).
# Manual runs: either one line BOT_PROXY=http://user:pass@host:port or split:
# BOT_PROXY_HOST=host:port
# BOT_PROXY_USER=
# BOT_PROXY_PASS=
# Or auto-fetch from a Webshare account (free tier): https://www.webshare.io → API token
# WEBSHARE_API_TOKEN=
# Webshare API mode: direct = ip:port per row; backbone = p.webshare.io (typical for residential).
# If Chrome shows ERR_TUNNEL_CONNECTION_FAILED on every IP, use backbone.
# WEBSHARE_PROXY_MODE=backbone
# On login/chrome-error with a pool-assigned proxy, multi-launcher refetches this many endpoints for a new IP
# WEBSHARE_ROTATE_FETCH_COUNT=25
# Cap automatic Webshare/pool proxy swaps per stuck bot (then retry same proxy)
# IMVU_MAX_PROXY_ROTATIONS=10
# Or any GET URL that returns JSON [{...}] / ["url"] / newline ip:port (optional)
# PROXY_DISCOVERY_URL=

# user-tracker: skip chat welcome if same username was welcomed within this window (ms). 0 = off. Cuts spam on leave/rejoin.
# IMVU_WELCOME_REJOIN_MS=600000
# room-joiner: force re-auth after N ms (0 = never). Example 24h: 86400000
# IMVU_SESSION_MAX_MS=0
# room-joiner: max wait for Join CTA (default 120000). Raise when running 2+ Chromes.
# IMVU_JOIN_CTA_WAIT_MS=120000
# After opening a room URL, wait this long for SPA / join-cta (datacenter proxies often need 45–90s).
# IMVU_ROOM_HYDRATE_MS=55000
# After login submit: wait for redirect off secure/welcome (ms). Raise on slow proxies.
# IMVU_POST_LOGIN_REDIRECT_MS=90000
# Log progress every N ms while waiting (0 = off).
# IMVU_POST_LOGIN_PROGRESS_MS=15000
# Extra settle time before loading Next (ms).
# IMVU_POST_LOGIN_SETTLE_MS=12000
# Polling windows for strict / relaxed session checks post-login (ms).
# IMVU_SESSION_STRICT_WAIT_MS=70000
# IMVU_SESSION_RELAXED_WAIT_MS=45000
#
# discord-server (node lurkbot-bot/discord-server.js): bot token + default guild/parent channel for per-room channels.
# DISCORD_TOKEN=
# DISCORD_CHANNEL_ID=
#
# imvu-bot / room-joiner → POST chat + init-room to this URL (discord-server listens on 3000):
# DISCORD_BOT_API_URL=http://127.0.0.1:3000/api/imvu-chat
#
# WebSocket debug (user-tracker): WS_DEBUG=1 logs only chat-shaped frames (room queue / messages mount) — not every presence ping (avoids Railway log rate limits). Full firehose: WS_DEBUG=verbose or WS_DEBUG_VERBOSE=1.
# WS_DEBUG=1
#
# Optional: duplicate DOM-based welcome + AI in imvu-bot (default off; CDP user-tracker handles it).
# IMVU_DOM_CHAT_AI=1
#
# multi-launcher sets IMVU_DISCORD_RELAY_PORTS + per-child IMVU_DISCORD_RELAY_PORT automatically.
# Solo `node room-joiner.js`: set both so discord-server can reach this process, e.g.
# IMVU_DISCORD_RELAY_PORT=30900
# IMVU_DISCORD_RELAY_PORTS=30900
# Optional first port when multi-launcher assigns 30900, 30901, …
# IMVU_DISCORD_RELAY_BASE=30900
#
# Room music (YouTube → ffmpeg → Icecast; each *play / !play replaces current track). Requires ffmpeg + Icecast.
# Setup: ./scripts/install-streaming-deps.sh  ·  quick local run: npm run local:icecast (starts Docker Icecast + silence, then app+bot)
#   Or: docker compose -f infra/icecast/docker-compose.yml up --build  (then npm run local in another terminal)
#   Homebrew Icecast: infra/icecast/start-silence-local.sh or brew install icecast
#
# --- Local music (uncomment + match ICECAST_SOURCE_PASSWORD to infra/icecast/icecast.xml / compose) ---
# MUSIC_ENABLED=true
# IMVU_MUSIC_ENABLED=1
# ICECAST_HOST=127.0.0.1
# ICECAST_PORT=8001
# ICECAST_MOUNT_TEMPLATE=/imvu-{room}.mp3
# ICECAST_SOURCE_USER=source
# ICECAST_SOURCE_PASSWORD=lurkbot_dev
# CLOUDFLARE_TUNNEL_AUTO=1
# # Leave empty so multi-launcher fills https://….trycloudflare.com/imvu-{room}.mp3 (brew install cloudflared)
# MUSIC_PUBLIC_STREAM_URL_TEMPLATE=
# Then: php artisan config:clear
#
# --- Idle autoplay when nobody requests a song (configured only in .env / Railway vars — not via IMVU chat) ---
# First non-empty source wins:
#   MUSIC_AUTOPLAY_TRACKS_JSON=[{"title":"Example","url":"https://www.youtube.com/watch?v=VIDEO_ID"}]
#     (single-line JSON array or {"items":[…]}; quote the whole value in .env and escape inner " as \")
#   MUSIC_AUTOPLAY_TRACKS_JSON_URL=https://example.com/your-playlist.json
#   MUSIC_AUTOPLAY_PLAYLIST_URL=https://www.youtube.com/playlist?list=PLxxxx   # expands via play-dl
#   MUSIC_PLAYLIST_URL=…   # legacy: same as JSON URL or YouTube playlist URL
# Optional: MUSIC_AUTOPLAY_PLAYLIST_MAX_ITEMS=100
# Delay (ms) before each new FFmpeg→Icecast source on the same mount (avoids HTTP 403 if Icecast is slow to drop the prior source). 0 = off.
# MUSIC_ICECAST_RECONNECT_MS=800
#
# Railway production (Icecast = separate service, private networking): short host + suffix → icecast.railway.internal
# ICECAST_HOST=icecast
# ICECAST_HOST_SUFFIX=.railway.internal
# ICECAST_PORT=8000
# ICECAST_MOUNT_TEMPLATE=/imvu-{room}.mp3
# ICECAST_SOURCE_USER=source
# ICECAST_SOURCE_PASSWORD=…
# HTTPS stream URL shown in chat (localhost/Icecast LAN is never posted).
# Choose auto-tunnel provider:
#   MUSIC_TUNNEL_PROVIDER=cloudflare   (recommended)
#   MUSIC_TUNNEL_PROVIDER=ngrok
#
# Option A — Cloudflare Tunnel (quick tunnel): Dockerfile installs cloudflared; set:
#   CLOUDFLARE_TUNNEL_AUTO=1
#   Leave MUSIC_PUBLIC_STREAM_URL_TEMPLATE empty (multi-launcher sets https://….trycloudflare.com/imvu-{room}.mp3).
#   Quick Tunnel registration can fail repeatedly from datacenter IPs — retries: CLOUDFLARE_QUICK_TUNNEL_RETRIES=4 (default), CLOUDFLARE_QUICK_TUNNEL_RETRY_MS=6000 (default).
#   Optional: CLOUDFLARE_TUNNEL_FORCE=1 (replace existing template each launch)
#   Optional stable hostname (named tunnel/DNS): CLOUDFLARED_HOSTNAME=stream.example.com
#   Optional binary path/args: CLOUDFLARED_PATH, CLOUDFLARED_EXTRA_ARGS
#   Readiness timeout: CLOUDFLARE_TUNNEL_READY_MS=45000
# If Cloudflare keeps failing: MUSIC_TUNNEL_FALLBACK_NGROK=1 and install ngrok + NGROK_AUTHTOKEN (see Option B), or Option C static URL.
#
# Option B — ngrok: install ngrok (`brew install ngrok/ngrok/ngrok`), then either:
#   `ngrok config add-authtoken <token>` (saves ~/.config/ngrok/ngrok.yml or Application Support path), or set
#   NGROK_AUTHTOKEN=<token from https://dashboard.ngrok.com/get-started/your-authtoken> in .env (spawned ngrok inherits it).
#   NGROK_TUNNEL_AUTO=1
#   Leave MUSIC_PUBLIC_STREAM_URL_TEMPLATE empty (multi-launcher sets https://….ngrok-free.app/imvu-{room}.mp3 via local agent API).
#   NGROK_TUNNEL_FORCE=1 replaces an existing *.ngrok* template on each launch. NGROK_PATH, NGROK_AGENT_API optional.
# Option C — your own HTTPS URL (path must match ICECAST_MOUNT_TEMPLATE, e.g. …/imvu-{room}.mp3):
# MUSIC_PUBLIC_STREAM_URL_TEMPLATE=https://your-tunnel.example.com/imvu-{room}.mp3
# MUSIC_PUBLIC_STREAM_URL_TEMPLATE=
# ICECAST_MOUNT_TEMPLATE=/imvu-{room}.mp3
# Wait for Icecast TCP before starting ngrok (avoids immediate 502 if the launcher beats Icecast). 0 = one quick probe only.
# MUSIC_TUNNEL_WAIT_ICECAST_SECONDS=30
# Max wait (ms) before chat posts the stream link — bot polls local Icecast until mount returns HTTP 200 (avoids immediate 404).
# MUSIC_CHAT_WAIT_MOUNT_MS=50000
# Delay (ms) before posting stream URL into IMVU Media DOM — mount exists only after FFmpeg connects (default 2500).
# MUSIC_DOM_STREAM_DELAY_MS=2500
# Override FFmpeg audio filter for pipe→Icecast (default fixes YouTube fragment DTS / “non monotonically increasing dts” spam).
# MUSIC_FFMPEG_AF=asetpts=PTS-STARTPTS,aresample=44100:async=1:min_hard_comp=0.1:max_soft_comp=0.9
# Append ?_play=… to HTTPS stream links so clients reopen a fresh connection each track (set 0 to disable).
# MUSIC_STREAM_URL_CACHE_BUST=1
# Require HTTPS public stream URL before queuing (no localhost listener links). Off for pure LAN dev: MUSIC_PUBLIC_STREAM_HTTPS_REQUIRED=0
# MUSIC_PUBLIC_STREAM_HTTPS_REQUIRED=1
